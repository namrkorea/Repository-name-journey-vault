# Google 3D 지도 브라우저용 키
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Places / Geocoding 서버용 키
GOOGLE_MAPS_SERVER_API_KEY=
# GOOGLE_PLACES_API_KEY=

# Supabase 프로젝트 설정
# 서비스 역할 키는 절대로 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 관리자 로그인
ADMIN_PASSWORD=
# 32자 이상의 무작위 문자열
ADMIN_SESSION_SECRET=

# OpenAI AI 여행계획
# API 키는 절대로 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# 선택 입력한 이메일로 저장된 여행계획 전송
# Resend API 키와 검증된 발신 도메인의 주소를 사용합니다.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Journey Vault <travel@send.example.com>
