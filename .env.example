# Google 3D 지도 브라우저용 키
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Places / Geocoding 서버용 키
GOOGLE_MAPS_SERVER_API_KEY=
# GOOGLE_PLACES_API_KEY=

# Firebase Firestore 서버 연결
# Firebase Console > Project settings > Service accounts > Generate new private key
# 아래 3개 값은 서비스 계정 JSON에서 복사합니다.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Firebase Trigger Email 확장 프로그램이 감시할 컬렉션
# 기본값은 mail 이므로 바꾸지 않으면 생략해도 됩니다.
FIREBASE_MAIL_COLLECTION=mail

# 관리자 로그인
ADMIN_PASSWORD=
# 32자 이상의 무작위 문자열
ADMIN_SESSION_SECRET=

# OpenAI AI 여행계획
# API 키는 절대로 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# 이메일은 Firebase Trigger Email + Gmail SMTP로 전송합니다.
# Gmail 주소와 앱 비밀번호는 Vercel이 아니라 Firebase Extension 설정에 입력합니다.

# ---- 아래 2개는 기존 Supabase 데이터를 Firebase로 1회 이전할 때만 사용 ----
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
